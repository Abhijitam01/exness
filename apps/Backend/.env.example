# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/nextrade_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=5000

# JWT
JWT_SECRET="change-me-in-production"

# OAuth - Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v2/auth/google/callback"

# OAuth - GitHub
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:5000/api/v2/auth/github/callback"

# Frontend URL (for OAuth redirect after login)
FRONTEND_URL="http://localhost:3000"

# Initial balance per new user in USD (stored as cents internally)
INITIAL_BALANCE_USD=50000
